# ── ОБЯЗАТЕЛЬНО ──────────────────────────────────────────────
# Ключ OpenRouter. Остаётся на сервере, в браузер не попадает.
OPENROUTER_API_KEY=sk-or-v1-...

# Ключ официального DeepSeek API (вкладка «Настройки» → Провайдеры).
# Если пусто, можно вписать ключ в карточку провайдера — в файл, не в браузер.
# DEEPSEEK_API_KEY=sk-...

# Ключ Yandex AI Studio для обогащения (YandexGPT / Alice / модели в каталоге Cloud).
# Scope yc.ai.foundationModels.execute — это НЕ ключ Search API.
# Folder ID тот же, что у поиска: YANDEX_FOLDER_ID.
# YANDEX_API_KEY=

# ── ДОСТУП ───────────────────────────────────────────────────
# Пароль на весь интерфейс и API. Браузер входит формой (cookie на неделю),
# скрипты и smoke — Basic. Пусто = сервер открыт, и любой, кто до него
# дотянется, тратит ключ выше. Для публикации задать обязательно.
APP_USER=admin
APP_PASSWORD=

# ── СЕТЬ ─────────────────────────────────────────────────────
PORT=3000
# 0.0.0.0 нужен в контейнере. Без пароля разумнее 127.0.0.1 и доступ по SSH-туннелю.
HOST=0.0.0.0
# Хосты, к которым разрешён прокси /api/product. Свободный URL от клиента —
# это доступ во внутреннюю сеть и к метаданным облака.
ALLOWED_HOSTS=mrmag.ru

# ── ВЫХОД В ИНТЕРНЕТ ─────────────────────────────────────────
# Cloudflare перед OpenRouter блокирует по географии адреса: с российского IP
# приходит 403 «Access denied by security policy» даже на публичный эндпоинт,
# без ключа. Лечится выходом через сеть другой страны.
#
# Удобнее всего: Настройки → Сеть — вставить tg://socks?server=…&port=…&user=…&pass=…
# и сохранить. OpenRouter с «Через прокси» ходит в SOCKS напрямую.
#
# Запасной вариант через .env (если в «Сеть» адрес пустой):
#   SOCKS_PROXY=tg://socks?server=1.2.3.4&port=3443&user=логин&pass=пароль
#   HTTPS_PROXY=http://127.0.0.1:18080
# Порт моста: SOCKS_BRIDGE_PORT (по умолчанию 18080).
# HTTP-прокси без SOCKS: HTTPS_PROXY=http://user:pass@proxy.example.com:3128
#
# Сервер должен уметь открыть TCP до IP:port прокси (иначе проверка покажет таймаут).
# mrmag.ru, DeepSeek и Yandex Search API через прокси гонять не нужно.
NO_PROXY=mrmag.ru,localhost,127.0.0.1,api.deepseek.com,.deepseek.com,searchapi.api.cloud.yandex.net,.api.cloud.yandex.net

# Где хранить правки из вкладки «Настройки». В контейнере — на томе /data,
# иначе пересборка образа затирает провайдеров и парсеры.
# SETTINGS_PATH=/data/config.json
# Курс печатается в отчётах и выводится в интерфейсе — обновлять вместе с датой.
RUB_PER_USD=80
RUB_RATE_DATE=18.08.2026
# flag — записать значение модели и факт из текста с пометкой (по умолчанию)
# strict — при расхождении обнулить поле модели
MISMATCH_POLICY=flag

# ── ОБХОД КАТАЛОГА ───────────────────────────────────────────
# Кэш страниц mrmag.ru. Должен быть на постоянном томе, иначе после каждого
# перезапуска раздел обходится заново.
PAGE_CACHE_DIR=.page_cache
PAGE_CACHE_TTL_MS=86400000
# Пауза между запросами к сайту, мс (~4 запроса в секунду).
CRAWL_GAP_MS=250

# ── ТОВАР БЕЗ ОПИСАНИЯ: ПОИСК В СЕТИ ─────────────────────────
# Основные параметры — config.json → search / search.yandex / search.duckduckgo.
# Переменные ниже перекрывают файл в момент запуска.
# Карточка пуста — ищем ту же модель: сначала Yandex Search API (Cloud v2),
# без ключа — DuckDuckGo HTML POST (регион ru-ru).
# WEB_LOOKUP=0 выключает поиск целиком (и config.search.enabled тоже).
# WEB_LOOKUP=0
WEB_LOOKUP_TRIES=3
# Таймаут страницы товара из выдачи, мс. Карточка идёт напрямую, не через SOCKS.
# WEB_PAGE_TIMEOUT_MS=20000
SEARCH_GAP_MS=3000
# Официальный Yandex Cloud Search API. Ключ (Api-Key, scope yc.search-api.execute)
# и Folder ID каталога с ролью search-api.editor. Можно вписать во вкладке
# «Настройки» → Парсеры, тогда в .env не нужны.
# YANDEX_SEARCH_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_SEARCH_TYPE=ru
# YANDEX_REGION=225
# Свой SearxNG / любой движок с %s — после Yandex, раньше DuckDuckGo.
# SEARCH_URL=https://searx.example/search?q=%s
# Регион и выдача DuckDuckGo (по умолчанию html + ru-ru из config.json).
# DDG_REGION=ru-ru
# DDG_ENDPOINT=html
# Свой URL HTML-выдачи (пусто = https://html.duckduckgo.com/html/).
# DDG_URL=

# ── ФОНОВЫЙ ПРОГОН (ВЕБ-ИНТЕРФЕЙС) ───────────────────────────
# Прогон считает сервер, а не вкладка браузера: её можно закрыть, зайти позже и
# увидеть прогресс и результат. Каталог должен быть на постоянном томе — иначе
# перезапуск сервера потеряет оплаченные товары вместо того, чтобы довести их.
JOBS_DIR=jobs
# Сколько хранить законченный прогон, мс (по умолчанию неделя).
JOBS_TTL_MS=604800000
# Сколько карточек обогащать сразу. 3 — сеть и модель перекрываются,
# поисковик по-прежнему ходит строго по одному (без капчи). Больше 8 нельзя.
# JOB_CONCURRENCY=3

# ── ПРОГОН CLI ───────────────────────────────────────────────
# CATEGORY=kholodilniki | stiralnye_mashiny | 523 | 467 | адрес раздела
CATEGORY=kholodilniki
MODEL=deepseek/deepseek-v3.2
# Без LIMIT обрабатывается весь раздел.
# LIMIT=10
# OUT_DIR=./out

# ── DOCKER ───────────────────────────────────────────────────
# Хостовый порт. 3000 занят другим проектом, на 3004 смотрит nginx-proxy-manager.
HOST_PORT=3004
# Базовый образ сборки. node:24-alpine тянется с Docker Hub, а TLS до
# registry-1.docker.io на этой сети зависает. По умолчанию — зеркало AWS.
# NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
# Если образ уже на машине: NODE_IMAGE=node:24-alpine и compose build --pull=false

# ── ОБЯЗАТЕЛЬНО ──────────────────────────────────────────────
# Ключ OpenRouter. Остаётся на сервере, в браузер не попадает.
OPENROUTER_API_KEY=sk-or-v1-...

# ── ДОСТУП ───────────────────────────────────────────────────
# Пароль на весь интерфейс и API (Basic). Пусто = сервер открыт, и любой,
# кто до него дотянется, тратит ключ выше. Для публикации задать обязательно.
APP_USER=admin
APP_PASSWORD=

# ── СЕТЬ ─────────────────────────────────────────────────────
PORT=3000
# 0.0.0.0 нужен в контейнере. Без пароля разумнее 127.0.0.1 и доступ по SSH-туннелю.
HOST=0.0.0.0
# Хосты, к которым разрешён прокси /api/product. Свободный URL от клиента —
# это доступ во внутреннюю сеть и к метаданным облака.
ALLOWED_HOSTS=mrmag.ru

# ── ВЫХОД В ИНТЕРНЕТ ─────────────────────────────────────────
# Cloudflare перед OpenRouter блокирует по географии адреса: с российского IP
# приходит 403 «Access denied by security policy» даже на публичный эндпоинт,
# без ключа. Лечится только выходом через сеть другой страны.
#
# SOCKS5 Node не понимает, поэтому поднимается мост на localhost. Нужны ОБЕ
# строки: вторая должна существовать до старта процесса, иначе часть версий
# Node её уже не подхватит и запрос уйдёт мимо прокси.
#   SOCKS_PROXY=tg://socks?server=1.2.3.4&port=3443&user=логин&pass=пароль
#   HTTPS_PROXY=http://127.0.0.1:18080
# Порт моста меняется через SOCKS_BRIDGE_PORT (по умолчанию 18080).
#
# HTTP-прокси — напрямую, без моста:
#   HTTPS_PROXY=http://user:pass@proxy.example.com:3128
# mrmag.ru через прокси гонять не нужно — это лишний крюк и лишняя точка отказа.
NO_PROXY=mrmag.ru,localhost,127.0.0.1

# ── КУРС И ПОЛИТИКИ ──────────────────────────────────────────
# Курс печатается в отчётах и выводится в интерфейсе — обновлять вместе с датой.
RUB_PER_USD=80
RUB_RATE_DATE=18.08.2026
# flag — записать значение модели и факт из текста с пометкой (по умолчанию)
# strict — при расхождении обнулить поле модели
MISMATCH_POLICY=flag

# ── ОБХОД КАТАЛОГА ───────────────────────────────────────────
# Кэш страниц mrmag.ru. Должен быть на постоянном томе, иначе после каждого
# перезапуска раздел обходится заново.
PAGE_CACHE_DIR=.page_cache
PAGE_CACHE_TTL_MS=86400000
# Пауза между запросами к сайту, мс (~4 запроса в секунду).
CRAWL_GAP_MS=250

# ── ТОВАР БЕЗ ОПИСАНИЯ: ПОИСК В СЕТИ ─────────────────────────
# Карточка пуста и в фиде, и на странице магазина — описание того же артикула
# ищется в сети и уходит в модель как своё, адрес источника пишется в
# source_url. WEB_LOOKUP=0 возвращает прежнее поведение (пропуск).
# WEB_LOOKUP=0
# Сколько найденных страниц пробовать на один товар.
WEB_LOOKUP_TRIES=3
# Пауза перед запросом к поисковику, мс: за частые запросы он отдаёт заглушку.
SEARCH_GAP_MS=3000
# Свой SearxNG вместо публичных поисковиков (%s — место запроса).
# SEARCH_URL=https://searx.example/search?q=%s

# ── ПРОГОН CLI ───────────────────────────────────────────────
# CATEGORY=kholodilniki | stiralnye_mashiny | 523 | 467 | адрес раздела
CATEGORY=kholodilniki
MODEL=deepseek/deepseek-v3.2
# Без LIMIT обрабатывается весь раздел.
# LIMIT=10
# OUT_DIR=./out

# ── DOCKER ───────────────────────────────────────────────────
# Хостовый порт. 3000 занят другим проектом, на 3004 смотрит nginx-proxy-manager.
HOST_PORT=3004
